@ARTICLE{trans1,
  abbr={Submitted},
  author={Moeini, AmirPouya and Dalai, Marco and Fàbregas, Albert Guillén i},
  title={The Expurgated Error Exponent is Not Universally Achievable},
  journal={Submitted to IEEE Transactions on Information Theory},
  year={2026},
  arxiv={2603.01736},
  selected={true},
  abstract={We study the universal attainability of the expurgated error exponent for discrete memoryless channels (DMCs). While the random-coding exponent is known to be universally attainable via maximum mutual information (MMI) decoding for DMCs, it remains open whether the expurgated exponent can be attained universally. We show that this is not the case in general. Specifically, we construct a family of DMCs for which no single sequence of codes can attain the expurgated exponent simultaneously for all channels in the family, even at rate zero. In addition, for the same channel family, we show that MMI decoding fails to achieve the expurgated exponent for any channel in the family.}
}



@ARTICLE{itw20262,
  abbr={Submitted},
  author={Moeini, AmirPouya and Fàbregas, Albert Guillén i},
  title={Universal Decoding for Unequal Error Protection},
  journal={Submitted to IEEE Information Theory Workshop (ITW 2027)},
  year={2026},
  arxiv={2610.15423},
  abstract={We study universal unequal error protection of a single special message over discrete memoryless channels. We construct a sequence of codes with a decoding rule that does not depend on the channel transition law. We derive an achievable error exponent for the special message while ensuring reliable decoding of the ordinary messages. The resulting exponent strictly improves on the natural equal-error-protection random-coding baseline and remains positive as the rate approaches capacity. For symmetric channels, it converges to the optimal red-alert exponent at capacity.}
}



@ARTICLE{itw20261,
  abbr={Submitted},
  author={Moeini, AmirPouya and Dalai, Marco and Fàbregas, Albert Guillén i},
  title={An Upper Bound to the Undetected Error Exponent with Erasure Decoding at Positive Rates},
  journal={Submitted to IEEE Information Theory Workshop (ITW 2027)},
  year={2026},
  arxiv={2610.15420},
  selected={true},
  abstract={We study the undetected-error exponent of discrete memoryless channels with erasure decoding. Assuming that the undetected-error and erasure probabilities vanish, we derive an upper bound on the undetected-error exponent at positive rates. The bound uses Somekh-Baruch's genie-aided argument where an auxiliary output provides the decoder with a list of codewords. It recovers Telatar's tight rate-zero converse and is at least as tight as the straight-line bound. A numerical example shows that the improvement over the straight-line bound can be strict.}
}



@ARTICLE{itw20263,
  abbr={Submitted},
  author={Moeini, AmirPouya and Dalai, Marco and Fàbregas, Albert Guillén i},
  title={A Counterexample to the Universal Achievability of the Expurgated Error Exponent},
  journal={Submitted to IEEE Information Theory Workshop (ITW 2027)},
  year={2026},
  abstract={We study the universal attainability of the expurgated error exponent for discrete memoryless channels (DMCs). Unlike the random coding exponent known to be universally attainable for every fixed input distribution via maximum mutual information (MMI) decoding, we show that the expurgated error exponent is not. We consider a DMC for which MMI decoding fails to achieve the expurgated exponent at rate zero. We then introduce two DMCs for which no single sequence of encoders and decoders can simultaneously attain the rate-zero expurgated exponent for both channels.}
}



@INPROCEEDINGS{isit2026,
  abbr={ISIT 2026},
  author={Moeini, AmirPouya and Fàbregas, Albert Guillén i},
  title={Random Gilbert-Varshamov Codes for Joint Source-Channel Coding},
  booktitle={IEEE International Symposium on Information Theory (ISIT)},
  year={2026},
  url={https://ieeexplore.ieee.org/document/11653877},
  doi={10.1109/ISIT62367.2026.11653877},
  arxiv={2601.14987},
  abstract={We propose a random coding technique for joint source-channel coding of discrete memoryless sources and channels. The approach builds on the random Gilbert-Varshamov code construction of Somekh-Baruch et al. and extends it to the joint source-channel setting. We show that the resulting ensemble attains the maximum of the random-coding and expurgated error exponents.}
}



@INPROCEEDINGS{izs2026,
  abbr={IZS 2026},
  author={Moeini, AmirPouya and Fàbregas, Albert Guillén i},
  title={Two-Class Joint Source-Channel Coding: Expurgated Exponents with i.i.d. Distributions},
  booktitle={International Zurich Seminar on Information and Communication (IZS)},
  year={2026},
  doi={10.3929/ethz-c-000796722},
  arxiv={2601.14985},
  abstract={This paper studies expurgated exponents for joint source-channel coding of discrete memoryless sources and channels under i.i.d. random coding. We show that a two-class partitioning of source sequences, where the codeword distribution depends on the source type, achieves an exponent at least as high as that of optimal single-class coding, in which the codeword distribution is independent of the source message.}
}



@INPROCEEDINGS{11240350,
  abbr={ITW 2025},
  author={Moeini, AmirPouya and Fàbregas, Albert Guillén i},
  booktitle={IEEE Information Theory Workshop (ITW)},
  title={Dual-Domain Exponent of Maximum Mutual Information Decoding},
  year={2025},
  pages={810-814},
  url={https://ieeexplore.ieee.org/document/11240350},
  doi={10.1109/ITW62417.2025.11240350},
  arxiv={2501.13724},
  selected={true},
  abstract={This paper provides a dual domain derivation of the error exponent of maximum mutual information (MMI) decoding with constant composition codes, showing it coincides with that of maximum likelihood decoding for discrete memoryless channels. The analysis is further extended to joint source-channel coding, demonstrating that the generalized MMI decoder achieves the same random coding error exponent as the maximum a posteriori decoder.}
}



@INPROCEEDINGS{11240453,
  abbr={ITW 2025},
  author={Moeini, AmirPouya and Fàbregas, Albert Guillén i},
  booktitle={IEEE Information Theory Workshop (ITW)},
  title={Class-Based Expurgation Attains Csiszár’s Expurgated Source-Channel Exponent},
  year={2025},
  pages={794-797},
  url={https://ieeexplore.ieee.org/document/11240453},
  doi={10.1109/ITW62417.2025.11240453},
  arxiv={2507.03481},
  selected={true},
  abstract={This paper studies expurgated error exponents for joint source-channel coding for discrete memoryless sources and channels. We consider a partition of the source messages into classes, where the codeword distributions depend on the class. We show that two carefully chosen classes suffice to achieve Csiszár’s expurgated exponent.}
}
